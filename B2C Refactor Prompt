### Database Schema
```sql
-- Artists Table (synced with Spotify)
CREATE TABLE artists (
  id UUID PRIMARY KEY,
  spotify_id VARCHAR(255) UNIQUE,
  name VARCHAR(255),
  bio TEXT,
  genres TEXT[],
  image_url TEXT,
  followers INTEGER,
  shopify_store_id UUID REFERENCES stores(id),
  created_at TIMESTAMP,
  updated_at TIMESTAMP
);

-- Stores Table (Shopify integration)
CREATE TABLE stores (
  id UUID PRIMARY KEY,
  shopify_store_id VARCHAR(255) UNIQUE,
  name VARCHAR(255),
  description TEXT,
  store_type VARCHAR(50), -- 'artist', 'venue', 'label', 'brand'
  logo_url TEXT,
  owner_id UUID, -- Can link to artist, venue, or label
  created_at TIMESTAMP,
  updated_at TIMESTAMP
);

-- Destinations Table (Google Places)
CREATE TABLE destinations (
  id UUID PRIMARY KEY,
  google_place_id VARCHAR(255) UNIQUE,
  name VARCHAR(255),
  category VARCHAR(50), -- 'stay', 'dining', 'shopping', 'wellness'
  address TEXT,
  lat DECIMAL(10, 8),
  lng DECIMAL(11, 8),
  price_level INTEGER,
  rating DECIMAL(2, 1),
  photos TEXT[],
  user_submitted BOOLEAN DEFAULT FALSE,
  user_id UUID REFERENCES users(id),
  created_at TIMESTAMP,
  updated_at TIMESTAMP
);

-- Adventures Table
CREATE TABLE adventures (
  id UUID PRIMARY KEY,
  name VARCHAR(255),
  description TEXT,
  category VARCHAR(50), -- 'poi', 'tour', 'outdoor', 'cultural'
  duration VARCHAR(50),
  price_range VARCHAR(50),
  lat DECIMAL(10, 8),
  lng DECIMAL(11, 8),
  booking_link TEXT,
  google_place_id VARCHAR(255), -- Optional: if from Google
  user_submitted BOOLEAN DEFAULT FALSE,
  user_id UUID REFERENCES users(id),
  created_at TIMESTAMP,
  updated_at TIMESTAMP
);

-- User Saved Items
CREATE TABLE user_saved_items (
  id UUID PRIMARY KEY,
  user_id UUID REFERENCES users(id),
  item_type VARCHAR(50), -- 'artist', 'store', 'destination', 'adventure'
  item_id UUID,
  created_at TIMESTAMP
);

-- Event Enhancement Links
CREATE TABLE event_enhancements (
  id UUID PRIMARY KEY,
  event_id UUID REFERENCES events(id),
  artist_id UUID REFERENCES artists(id),
  store_id UUID REFERENCES stores(id),
  created_at TIMESTAMP
);
```

