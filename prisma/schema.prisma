// ============================================================================
// OPPORTUNITIES SYSTEM - Cross-platform job/opportunity postings
// ============================================================================

enum OpportunityCategory {
  RFP_JOB // Vendor/Contractor RFPs and Jobs
  CAREER_FULL_TIME // Full-time career positions
  CAREER_PART_TIME // Part-time positions
  CAREER_SEASONAL // Seasonal positions
  CAREER_INTERN // Internship positions
  AUDITION_CASTING // Auditions and casting calls
  CONTRACTOR // Contractor opportunities
  SUBCONTRACTOR // Subcontractor opportunities
  INDEPENDENT // Independent contractor
  SPONSOR // Sponsorship opportunities
  BRAND_AMBASSADOR // Brand ambassador programs
  STREET_TEAM // Street team positions
  INFLUENCER // Influencer/content creator
  AFFILIATE // Affiliate program opportunities
}

enum OpportunityStatus {
  DRAFT // Being created
  PUBLISHED // Live and accepting applications
  PAUSED // Temporarily not accepting applications
  CLOSED // No longer accepting applications
  FILLED // Position has been filled
  CANCELLED // Opportunity cancelled
}

enum ApplicationStatus {
  SUBMITTED // Application submitted
  UNDER_REVIEW // Being reviewed
  SHORTLISTED // Moved to shortlist
  INTERVIEW // Interview scheduled
  OFFER_PENDING // Offer being prepared
  OFFER_SENT // Offer sent to applicant
  ACCEPTED // Applicant accepted offer
  REJECTED // Application rejected
  WITHDRAWN // Applicant withdrew
  ONBOARDING // In onboarding process
  COMPLETED // Onboarding completed
}

model Opportunity {
  id          String              @id @default(cuid())
  title       String
  description String // Rich text description
  category    OpportunityCategory
  status      OpportunityStatus   @default(DRAFT)

  // Organization & Project
  organizationId String
  projectId      String?
  eventId        String? // Optional link to specific event

  // Details
  location             String? // Location or "Remote"
  locationType         String? // "onsite", "remote", "hybrid"
  compensationType     String? // "hourly", "salary", "project", "commission", "volunteer"
  compensationMin      Decimal? @db.Decimal(10, 2)
  compensationMax      Decimal? @db.Decimal(10, 2)
  compensationCurrency String?  @default("USD")

  // Requirements
  requirements     Json? // Structured requirements
  qualifications   Json? // Required qualifications
  responsibilities Json? // Job responsibilities
  benefits         Json? // Benefits offered

  // Timeline
  startDate           DateTime?
  endDate             DateTime?
  applicationDeadline DateTime?

  // Application settings
  requireResume      Boolean @default(true)
  requireCoverLetter Boolean @default(false)
  requirePortfolio   Boolean @default(false)
  customQuestions    Json? // Custom application questions

  // Metadata
  tags             String[]
  viewCount        Int      @default(0)
  applicationCount Int      @default(0)

  // Publishing
  publishedAt DateTime?
  publishedBy String?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  event        Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  applications OpportunityApplication[]

  @@index([organizationId])
  @@index([projectId])
  @@index([eventId])
  @@index([category])
  @@index([status])
  @@index([publishedAt])
  @@index([applicationDeadline])
  @@map("opportunities")
}

model OpportunityApplication {
  id            String            @id @default(cuid())
  opportunityId String
  userId        String
  status        ApplicationStatus @default(SUBMITTED)

  // Application data
  resumeUrl     String?
  coverLetter   String?
  portfolioUrl  String?
  customAnswers Json? // Answers to custom questions

  // Contact info (may differ from user profile)
  contactEmail String
  contactPhone String?

  // Review process
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  rating      Int? // 1-5 rating

  // Interview & offer
  interviewDate   DateTime?
  interviewNotes  String?
  offerDetails    Json?
  offerSentAt     DateTime?
  offerAcceptedAt DateTime?

  // Metadata
  source     String? // How they found the opportunity
  referredBy String? // Referral user ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer    User?       @relation("ApplicationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([opportunityId, userId]) // One application per user per opportunity
  @@index([opportunityId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("opportunity_applications")
}

// ============================================================================
// GLOBAL CATALOG SYSTEM - Production Advancing Catalog
// ============================================================================

model CatalogCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories CatalogSubcategory[]
  items         CatalogItem[]

  @@index([slug])
  @@index([active, order])
  @@map("catalog_categories")
}

model CatalogSubcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items    CatalogItem[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([active, order])
  @@map("catalog_subcategories")
}

model CatalogItem {
  id            String  @id @default(cuid())
  categoryId    String
  subcategoryId String?

  // Core fields
  name           String
  slug           String
  description    String?
  specifications String? // Detailed specs

  // Universal fields
  standardUnit   String // e.g., "each", "hour", "day", "person", "lb", "ft"
  alternateNames String[] // For fuzzy searching

  // Contextual fields (optional, stored as structured data)
  make              String?
  model             String?
  dimensions        String? // e.g., "24x36x48 inches"
  weight            String? // e.g., "50 lbs"
  material          String?
  color             String?
  capacity          String?
  powerRequirements String?

  // Metadata
  searchTerms String[] // Additional search keywords
  tags        String[]

  // Pricing & availability
  typicalQuantity Int?
  estimatedCost   String? // e.g., "$150-300 per day"

  // Relationships
  accessories  Json? // Array of related item IDs
  relatedItems Json? // Array of related item IDs

  // Management
  isGlobal       Boolean @default(true) // true = global catalog, false = org-specific
  organizationId String? // null for global, set for custom items

  // Requirements & metadata
  requiresCertification Boolean  @default(false)
  requiresInsurance     Boolean  @default(false)
  leadTime              String? // e.g., "2 weeks", "3 days"
  seasonalAvailability  String[] // e.g., ["summer", "winter"]
  commonVendors         String[]

  // Status
  active Boolean @default(true)
  order  Int     @default(0)

  // Additional metadata
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     CatalogCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory  CatalogSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Organization-level toggles
  organizationToggles OrganizationCatalogToggle[]
  projectToggles      ProjectCatalogToggle[]
  teamToggles         TeamCatalogToggle[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([organizationId])
  @@index([isGlobal, active])
  @@index([slug])
  @@map("catalog_items")
}

// Organization-level catalog management
model OrganizationCatalogToggle {
  id             String   @id @default(cuid())
  organizationId String
  catalogItemId  String
  enabled        Boolean  @default(true)
  customName     String? // Override item name for this org
  customCost     String? // Override cost estimate
  notes          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([organizationId, catalogItemId])
  @@index([organizationId])
  @@index([catalogItemId])
  @@index([enabled])
  @@map("organization_catalog_toggles")
}

// Project-level catalog management
model ProjectCatalogToggle {
  id            String   @id @default(cuid())
  projectId     String
  catalogItemId String
  enabled       Boolean  @default(true)
  customName    String?
  customCost    String?
  notes         String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, catalogItemId])
  @@index([projectId])
  @@index([catalogItemId])
  @@index([enabled])
  @@map("project_catalog_toggles")
}

// Team-level catalog management
model TeamCatalogToggle {
  id            String   @id @default(cuid())
  teamId        String
  catalogItemId String
  enabled       Boolean  @default(true)
  customName    String?
  customCost    String?
  notes         String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([teamId, catalogItemId])
  @@index([teamId])
  @@index([catalogItemId])
  @@index([enabled])
  @@map("team_catalog_toggles")
}

// Analytics tracking
model AnalyticsData {
  id         String   @id @default(cuid())
  userId     String?
  eventType  String
  eventName  String
  properties Json?
  timestamp  DateTime @default(now())
  sessionId  String?
  userAgent  String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([eventName])
  @@index([timestamp])
  @@index([sessionId])
  @@map("analytics_data")
}

// ============================================================================
// IMPERSONATION MODELS - Legend Role Features
// ============================================================================

// Impersonation sessions for Legend roles
model ImpersonationSession {
  id              String    @id @default(cuid())
  impersonatorId  String
  targetUserId    String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  expiresAt       DateTime?
  reason          String?
  ipAddress       String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  impersonator User @relation("ImpersonatorSessions", fields: [impersonatorId], references: [id], onDelete: Cascade)
  targetUser   User @relation("TargetUserSessions", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([impersonatorId])
  @@index([targetUserId])
  @@index([startedAt])
  @@index([endedAt])
  @@map("impersonation_sessions")
}

// Impersonation permissions granted by users
model ImpersonationPermission {
  id          String   @id @default(cuid())
  userId      String
  grantedToId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  grantedTo User @relation("GrantedToPermissions", fields: [grantedToId], references: [id], onDelete: Cascade)

  @@unique([userId, grantedToId])
  @@index([userId])
  @@index([grantedToId])
  @@index([expiresAt])
  @@map("impersonation_permissions")
}

// ============================================================================
// ADDITIONAL ATLVS MODELS - Inventory & Workflows
// ============================================================================

model Inventory {
  id            String   @id @default(cuid())
  itemName      String
  category      String
  quantity      Int      @default(0)
  unit          String
  minStockLevel Int?
  location      String?
  supplier      String?
  cost          Decimal? @db.Decimal(10, 2)
  status        String   @default("in-stock")
  lastRestocked DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([location])
  @@map("inventory")
}

model Workflow {
  id              String   @id @default(cuid())
  name            String
  description     String?
  category        String
  steps           Json // Array of workflow steps
  automationLevel String   @default("manual")
  tags            String[]
  usageCount      Int      @default(0)
  lastUsed        DateTime?
  status          String   @default("active")
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([createdBy])
  @@map("workflows")
}

// ============================================================================
// ADDITIONAL COMPVSS MODELS - Assets & Documents
// ============================================================================

model CompvssAsset {
  id            String   @id @default(cuid())
  name          String
  category      String
  serialNumber  String?  @unique
  status        String   @default("available")
  location      String?
  condition     String?
  purchaseDate  DateTime?
  purchasePrice Decimal? @db.Decimal(10, 2)
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  checkouts CompvssAssetCheckout[]

  @@index([status])
  @@index([category])
  @@index([location])
  @@map("compvss_assets")
}

model CompvssAssetCheckout {
  id          String    @id @default(cuid())
  assetId     String
  userId      String
  dueDate     DateTime
  purpose     String?
  notes       String?
  checkedOutAt DateTime @default(now())
  checkedInAt  DateTime?
  condition    String?
  status       String   @default("checked-out")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  asset CompvssAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([userId])
  @@index([status])
  @@map("compvss_asset_checkouts")
}

model CompvssDocument {
  id            String   @id @default(cuid())
  name          String
  type          String
  folder        String?
  permissions   String   @default("team")
  tags          String[]
  fileUrl       String
  size          Int
  uploadedBy    String?
  uploadedDate  DateTime @default(now())
  lastModified  DateTime @updatedAt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([folder])
  @@index([permissions])
  @@index([uploadedBy])
  @@map("compvss_documents")
}
