    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      whileHover={{ y: -5 }}
      transition={{ duration: 0.3 }}
      role="listitem"
    >
      <Card variant="gvteway" className="h-full bg-gray-900/50 backdrop-blur-sm">
