{
  "name": "ATLVS - Advancing Approval Routing",
  "nodes": [
    {
      "parameters": {
        "operation": "create",
        "category": "PRODUCTION",
        "description": "={{$json[\"description\"]}}",
        "priority": "NORMAL"
      },
      "name": "Create Advancing Request",
      "type": "n8n-nodes-base.compvssAdvancing",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [{"value1": "={{$json[\"estimatedCost\"]}}", "operation": "larger", "value2": 5000}]
        }
      },
      "name": "Check Amount",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fromEmail": "advancing@atlvs.com",
        "toEmail": "director@atlvs.com",
        "subject": "High-Value Advancing Request",
        "message": "Request requires director approval: ${{$node[\"Create Advancing Request\"].json[\"estimatedCost\"]}}"
      },
      "name": "Director Approval",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [650, 250]
    },
    {
      "parameters": {
        "operation": "updateStatus",
        "requestId": "={{$node[\"Create Advancing Request\"].json[\"id\"]}}",
        "status": "APPROVED"
      },
      "name": "Auto Approve",
      "type": "n8n-nodes-base.compvssAdvancing",
      "typeVersion": 1,
      "position": [650, 400]
    }
  ],
  "connections": {
    "Create Advancing Request": {"main": [[{"node": "Check Amount", "type": "main", "index": 0}]]},
    "Check Amount": {"main": [[{"node": "Director Approval", "type": "main", "index": 0}], [{"node": "Auto Approve", "type": "main", "index": 0}]]}
  },
  "active": true,
  "tags": ["atlvs", "advancing"]
}
