{
  "name": "COMPVSS - Credential Expiration Alert",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "cronExpression", "expression": "0 8 * * *"}]
        }
      },
      "name": "Daily Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "checkExpiration",
        "userId": "all",
        "daysBeforeExpiry": 30
      },
      "name": "Check Credentials",
      "type": "n8n-nodes-base.universalCredential",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fromEmail": "credentials@compvss.com",
        "toEmail": "={{$json[\"userEmail\"]}}",
        "subject": "Credential Expiring Soon",
        "message": "Your {{$json[\"type\"]}} credential expires on {{$json[\"expiryDate\"]}}"
      },
      "name": "Send Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Daily Check": {"main": [[{"node": "Check Credentials", "type": "main", "index": 0}]]},
    "Check Credentials": {"main": [[{"node": "Send Alert", "type": "main", "index": 0}]]}
  },
  "active": true,
  "tags": ["compvss", "credentials"]
}
