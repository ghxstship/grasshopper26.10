{
  "name": "COMPVSS - Team Notification",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "team-notify"},
      "name": "Notification Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.email FROM users u JOIN team_members tm ON tm.userId = u.id WHERE tm.teamId = '{{$json[\"teamId\"]}}'"
      },
      "name": "Get Team",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "fromEmail": "team@compvss.com",
        "toEmail": "={{$json[\"email\"]}}",
        "subject": "Team Update",
        "message": "{{$node[\"Notification Trigger\"].json[\"message\"]}}"
      },
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Notification Trigger": {"main": [[{"node": "Get Team", "type": "main", "index": 0}]]},
    "Get Team": {"main": [[{"node": "Send Email", "type": "main", "index": 0}]]}
  },
  "active": true,
  "tags": ["compvss", "team"]
}
