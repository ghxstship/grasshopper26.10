{
  "name": "GHXSTSHIP Design System",
  "version": "1.0.0",
  "aesthetic": "Contemporary Minimal Pop Art",
  "enforcementPolicy": "zero-tolerance",
  "implementationDate": "2025-11-18",
  
  "rules": {
    "colors": {
      "palette": "monochromatic",
      "allowed": [
        "#000000",
        "#FFFFFF",
        "#F5F5F5",
        "#E5E5E5",
        "#D4D4D4",
        "#A3A3A3",
        "#737373",
        "#525252",
        "#404040",
        "#262626",
        "#171717",
        "#0A0A0A",
        "#FAFAFA"
      ],
      "platformGradients": {
        "gvteway": ["#FF0000", "#FFD700", "#0066FF"],
        "atlvs": ["#00FF00", "#FF8800", "#8800FF"],
        "compvss": ["#00FFFF", "#00CED1", "#4B0082"]
      },
      "gradientUsage": "text-only"
    },
    
    "typography": {
      "fonts": {
        "display": "Anton",
        "headers": "Bebas Neue",
        "body": "Share Tech",
        "metadata": "Share Tech Mono"
      },
      "components": {
        "required": true,
        "location": "@/components/atoms/Typography",
        "types": [
          "HeroTitle",
          "DisplayTitle",
          "SectionHeader",
          "SubsectionHeader",
          "CardTitle",
          "BodyText",
          "BodyTextLarge",
          "BodyTextSmall",
          "MetaText",
          "CaptionText"
        ]
      },
      "rawHtmlElements": {
        "allowed": false,
        "forbidden": ["h1", "h2", "h3", "h4", "h5", "h6", "p"]
      }
    },
    
    "components": {
      "atomicDesign": {
        "required": true,
        "location": "@/components/atoms/",
        "variants": ["atlvs", "compvss", "gvteway", "default"]
      },
      "customStyling": {
        "allowed": false,
        "message": "Use atomic components with variants instead"
      }
    },
    
    "shadows": {
      "type": "hard-geometric",
      "allowed": [
        "shadow-hard",
        "shadow-hard-inverse",
        "shadow-hard-grey",
        "shadow-outline",
        "shadow-outline-black",
        "shadow-outline-white"
      ],
      "forbidden": [
        "shadow-sm",
        "shadow-md",
        "shadow-lg",
        "shadow-xl",
        "shadow-2xl"
      ]
    },
    
    "patterns": {
      "geometric": true,
      "available": [
        "bg-halftone",
        "bg-dots",
        "bg-diagonal-stripes",
        "bg-grid"
      ]
    },
    
    "images": {
      "treatment": "high-contrast-bw",
      "filters": ["img-bw", "img-pop-art"],
      "required": true
    },
    
    "spacing": {
      "system": "8px-grid",
      "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128, 160, 192, 256]
    },
    
    "borders": {
      "widths": [1, 2, 3],
      "default": 2,
      "emphasis": 3
    }
  },
  
  "enforcement": {
    "preCommit": true,
    "ci": true,
    "scripts": {
      "check": "npm run design:enforce",
      "validate": "npm run design:validate",
      "fix": "npm run atomic:fix:typography"
    },
    "exitCodes": {
      "success": 0,
      "violations": 1
    },
    "violations": {
      "tolerance": "zero",
      "blocking": true,
      "types": [
        "color",
        "typography",
        "component",
        "shadow",
        "gradient",
        "font"
      ]
    }
  },
  
  "documentation": {
    "reference": "/Design System Reference",
    "implementation": "/docs/GHXSTSHIP_DESIGN_SYSTEM.md",
    "quickStart": "/GHXSTSHIP_DESIGN_SYSTEM_README.md",
    "summary": "/DESIGN_SYSTEM_IMPLEMENTATION_SUMMARY.md",
    "atomicDesign": "/docs/architecture/ATOMIC_DESIGN_SYSTEM.md"
  },
  
  "philosophy": {
    "principles": [
      "Bold typography as primary design element",
      "Stark contrast - pure black and white",
      "Geometric precision - hard-edged shapes",
      "Halftone texture for depth without color",
      "Screen print aesthetic - sharp lines, flat colors",
      "Brutalist function - raw, honest, purposeful"
    ],
    "influences": [
      "Andy Warhol - Repetition, screen printing",
      "Roy Lichtenstein - Ben-Day dots, comic aesthetic",
      "Bauhaus - Geometric precision, functional design",
      "Swiss/International Style - Grid systems, clean typography",
      "Brutalism - Raw, honest, bold forms"
    ],
    "tagline": "GHXSTSHIP doesn't follow trends. GHXSTSHIP creates them."
  }
}
